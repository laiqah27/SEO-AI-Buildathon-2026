 if('research' in D)return research(D.research);
 if('savechat' in D)return saveChat(D.savechat);
 if('editchat' in D)return chatForm(D.editchat);
 if('dup' in D){const c=C(D.dup);snap();const n={...JSON.parse(JSON.stringify(c)),id:uid(),status:'scheduled',ai:null};const d=new Date(c.start);d.setDate(d.getDate()+7);n.start=lt(d);S.chats.push(n);save();render();chatView(n.id);return toast('Duplicated one week later — adjust the date.')}
 if('delchat' in D){const c=C(D.delchat),p=P(c.pid)||{};return openPanel(`<h1>Delete this chat?</h1><p>Deletes the ${fd(c.start)} chat with ${esc(p.name)} including its notes and AI summary. ${esc(p.name)}'s profile and other chats are kept.</p><div class="bar"><button class="d" data-dodelc="${c.id}">Delete chat</button><button data-close>Cancel</button></div>`)}
 if('dodelc' in D){snap();S.chats=S.chats.filter(c=>c.id!=D.dodelc);save();closePanel();render();return toast('Chat deleted.',1)}
 if('sum' in D)return summarise(D.sum);
 if('editsum' in D)return editSum(D.editsum);
 if('delsum' in D){snap();C(D.delsum).ai=null;save();render();chatView(D.delsum);return toast('Summary removed.',1)}
 if('savesum' in D){const c=C(D.savesum);snap();c.ai={summary:$('#s_sum').value,advice:lines('#s_adv'),actions:lines('#s_act'),followups:lines('#s_fol'),tags:$('#s_tag').value.split(',').map(s=>s.trim()).filter(Boolean)};save();render();return chatView(c.id)}
 if('resched' in D){const v=$('#rs').value;if(!v)return toast('Pick a date and time.');snap();C(D.resched).start=v;save();render();chatView(D.resched);return toast('Rescheduled.',1)}
 if('ask' in D)return ask(D.ask);
 if('export' in D){const s=JSON.stringify(S,null,2);(async()=>{try{const dl=await claude.use('downloads');if(!dl)throw 0;await dl.save({filename:'networking-data.json',data:s})}catch(x){toast('Download isn\'t available here.')}})();return}
 if('tick' in D){const[a,i]=D.tick.split('|'),q=C(a).prep[+i];q.done=!q.done;save();return pv(a)}
 if('delq' in D){const[a,i]=D.delq.split('|');C(a).prep.splice(+i,1);save();return pv(a)}
 if('addq' in D){const v=$('#nq').value.trim();if(!v)return;const c=C(D.addq);(c.prep=c.prep||[]).push({t:v,g:'My question',done:0});save();return pv(D.addq)}
 if('genq' in D)return genQ(D.genq);
 if('import' in D)return importJSON();
 if('addtag' in D){const v=$('#nt').value.trim();if(!v)return toast('Enter a tag name.');if(S.tags.some(x=>x.toLowerCase()==v.toLowerCase()))return toast('That tag already exists.');S.tags.push(v);save();return render()}
 if('rentag' in D)return openPanel(`<h1>Rename tag</h1><input id="rt" value="${esc(D.rentag)}"><div class="bar" style="margin-top:14px"><button class="p" data-dotag="${esc(D.rentag)}">Rename</button><button data-close>Cancel</button></div>`);
 if('dotag' in D){const o=D.dotag,n=$('#rt').value.trim();if(!n)return toast('Enter a name.');snap();const m=a=>[...new Set((a||[]).map(x=>x==o?n:x))];S.tags=m(S.tags);S.chats.forEach(c=>{c.tags=m(c.tags);if(c.ai)c.ai.tags=m(c.ai.tags)});S.people.forEach(p=>p.tags=m(p.tags));save();closePanel();render();return toast('Tag renamed everywhere.',1)}
 if('deltag' in D)return openPanel(`<h1>Delete tag “${esc(D.deltag)}”?</h1><p>It is removed from every chat and person. Notes and advice are not affected.</p><div class="bar"><button class="d" data-dodeltag="${esc(D.deltag)}">Delete tag</button><button data-close>Cancel</button></div>`);
 if('dodeltag' in D){const o=D.dodeltag,m=a=>(a||[]).filter(x=>x!=o);snap();S.tags=m(S.tags);S.chats.forEach(c=>{c.tags=m(c.tags);if(c.ai)c.ai.tags=m(c.ai.tags)});S.people.forEach(p=>p.tags=m(p.tags));save();closePanel();render();return toast('Tag deleted.',1)}
 if('clearaf' in D){AF={};return rAi()}
 if('demo' in D)return demo();
 if('rmdemo' in D){snap();const ids=new Set(S.people.filter(p=>p.demo).map(p=>p.id));S.chats=S.chats.filter(c=>!c.demo);S.people=S.people.filter(p=>!p.demo||S.chats.some(c=>c.pid==p.id));S.people.forEach(p=>{if(p.demo)p.demo=0});save();render();return toast('Demo data removed.',1)}
 if('wipe' in D){return openPanel(`<h1>Delete all data?</h1><p>This removes every person, chat, note and summary. You can undo right after, but not later. Export first if unsure.</p><div class="bar"><button class="d" data-dowipe="1">Delete everything</button><button data-close>Cancel</button></div>`)}
});
document.addEventListener('click',e=>{if(e.target.dataset.dowipe){snap();S={people:[],chats:[],settings:S.settings};save();closePanel();render();toast('All data deleted.',1)}});
document.addEventListener('input',e=>{if(e.target.id=='pq'){pq=e.target.value;rPpl()}});
document.addEventListener('change',e=>{if(e.target.id=='pind'){pind=e.target.value;rPpl()}if(e.target.id=='ptag'){ptag=e.target.value;rPpl()}if(e.target.id=='pco'){pco=e.target.value;rPpl()}if(e.target.id=='pfrom'){pfrom=e.target.value;rPpl()}if(e.target.dataset.af!==undefined)AF[e.target.dataset.af]=e.target.value;if(e.target.id=='psort'){psort=e.target.value;rPpl()}});
document.addEventListener('keydown',e=>{if(e.key=='Escape')closePanel()});
load();render();
(async()=>{try{const [u,db,sm]=await Promise.all([claude.use('user'),claude.use('db'),claude.use('sample')]);sample=sm;if(db&&u){const id=await u.id();dbDoc=db.collection('data/users/'+id).doc('state');try{const d=await dbDoc.get();const j=d&&(d.data?d.data():d);if(j?.json&&!S.people.length&&!S.chats.length){S=Object.assign(S,JSON.parse(j.json));view=S.settings.view||'month';render()}}catch(e){}}}catch(e){}})();
</script></body></html>
