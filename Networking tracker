<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Coffee Chat Tracker</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{box-sizing:border-box;--bg:#f8f9fb;--card:#fff;--ink:#1c2230;--mut:#6b7385;--line:#e4e7ee;--acc:#2f6bed;--accbg:#eaf0fe;--red:#d64545;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#14171f;--card:#1c212c;--ink:#e8ebf2;--mut:#9aa3b6;--line:#2c3342;--acc:#6b95f5;--accbg:#232c45}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Inter,system-ui,-apple-system,Segoe UI,sans-serif;display:flex;min-height:100vh}
nav{width:216px;background:var(--card);border-right:1px solid var(--line);padding:20px 12px;position:sticky;top:0;height:100vh;flex-shrink:0}
.logo{font-weight:700;font-size:16px;padding:0 10px 18px;display:flex;gap:8px;align-items:center}.logo i{width:24px;height:24px;border-radius:7px;background:var(--acc);display:inline-block}
nav a{display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:9px;color:var(--mut);cursor:pointer;margin-bottom:2px;font-weight:500}
nav a:hover{background:var(--bg)}nav a.on{background:var(--accbg);color:var(--acc)}nav svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8}
main{flex:1;padding:28px 32px;max-width:1100px;min-width:0}
h1{font-size:22px;margin:0 0 4px}h2{font-size:15px;margin:18px 0 6px}.sub{color:var(--mut);margin-bottom:18px}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:16px}.sp{flex:1}
button,.btn{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 12px;border-radius:9px;cursor:pointer;transition:.15s}
button:hover{border-color:var(--acc)}button.p{background:var(--acc);border-color:var(--acc);color:#fff}button.d{color:var(--red)}button.on{background:var(--accbg);color:var(--acc);border-color:var(--acc)}button:disabled{opacity:.5;cursor:wait}
input,select,textarea{font:inherit;width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:9px;background:var(--card);color:var(--ink)}
textarea{min-height:84px;resize:vertical}input:focus,select:focus,textarea:focus{outline:2px solid var(--accbg);border-color:var(--acc)}
label{display:block;font-size:12px;color:var(--mut);margin:10px 0 3px;font-weight:600}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 1px 2px rgba(20,30,50,.04)}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.dh{background:var(--bg);padding:6px;font-size:12px;color:var(--mut);text-align:center}.day{background:var(--card);min-height:96px;padding:5px;cursor:pointer;min-width:0}.day.o{background:var(--bg)}.day b{font-size:12px;color:var(--mut)}.day.t b{background:var(--acc);color:#fff;border-radius:10px;padding:0 6px}
.ev{display:block;font-size:12px;background:var(--accbg);color:var(--acc);border-radius:6px;padding:2px 6px;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}.ev.past{background:var(--bg);color:var(--mut)}.ev.x{text-decoration:line-through}
.tag{display:inline-block;font-size:11px;background:var(--accbg);color:var(--acc);border-radius:20px;padding:1px 8px;margin:0 4px 4px 0}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}th{font-size:12px;color:var(--mut);cursor:pointer}tr.r{cursor:pointer}tr.r:hover{background:var(--bg)}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}.cards .card{cursor:pointer}
#ov{position:fixed;inset:0;background:rgba(10,15,30,.35);display:none;z-index:5}#ov.s{display:block}
#pn{position:fixed;top:0;right:0;bottom:0;width:min(480px,100%);background:var(--card);border-left:1px solid var(--line);padding:22px;overflow:auto;z-index:6;transform:translateX(100%);transition:.2s;padding-bottom:calc(22px + env(safe-area-inset-bottom,0px));padding-top:calc(22px + env(safe-area-inset-top,0px))}#pn.s{transform:none}
.ai{background:var(--accbg);border-radius:10px;padding:10px 12px;margin-top:6px}.ai small{color:var(--acc);font-weight:700;text-transform:uppercase;font-size:10px;letter-spacing:.05em}
.mut{color:var(--mut)}.row{display:flex;gap:8px}.row>*{flex:1}.link{color:var(--acc);cursor:pointer;text-decoration:underline}
.msg{margin:10px 0;padding:12px 14px;border-radius:12px;white-space:pre-wrap}.msg.u{background:var(--accbg);margin-left:60px}.msg.a{background:var(--card);border:1px solid var(--line)}
.prompts{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px;margin:14px 0}.prompts div{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:10px;cursor:pointer;font-size:13px}.prompts div:hover{border-color:var(--acc)}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;display:none;z-index:9;gap:12px;align-items:center}#toast.s{display:flex}#toast u{cursor:pointer}
.empty{text-align:center;color:var(--mut);padding:40px 10px}.demo{font-size:10px;border:1px dashed var(--mut);border-radius:6px;padding:0 5px;color:var(--mut)}
@media(max-width:760px){body{flex-direction:column}nav{width:100%;height:auto;position:static;display:flex;flex-wrap:wrap;padding:8px;gap:2px}.logo{display:none}nav a{flex:1;justify-content:center;padding:8px 4px}nav a span{display:none}main{padding:16px}.day{min-height:60px}.ev{font-size:10px}.msg.u{margin-left:20px}.row{flex-direction:column}}
</style></head><body>
<nav id="nav"></nav><main id="main"></main><div id="ov"></div><aside id="pn"></aside><div id="toast"></div>
<script>
const ICON={cal:'<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>',ppl:'<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.5-4 3-6 6.500-6s6 2 6.500 6M16 4.500a3.500 3.500 0 010 7M18 14c2 .6 3 2.500 3.500 6"/>',ai:'<path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path d="M19 16v4M17 18h4"/>',set:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>'};
const PAGES=[['cal','Calendar'],['ppl','People'],['ai','Ask AI'],['set','Settings']];
const KEY='cct-v1';const SUG=['Software Engineering','AI and Machine Learning','Data Science','Internships','Technical Skills','Career Planning','Networking','Technical Interviews','Finance','Communication'];let S={people:[],chats:[],tags:[],settings:{len:'concise',dur:30,view:'month'}};
let page='cal',view='month',cur=new Date(),pq='',pind='',ptag='',pco='',pfrom='',AF={},pmode='table',psort='name',chatLog=[],undoSnap=null,dbDoc=null,sample=null,booted=false;
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,10),pad=n=>String(n).padStart(2,'0');
const ld=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate()+0)}`,lt=d=>`${ld(d)}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
const fmt=s=>s?new Date(s).toLocaleString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}):'';
const fd=s=>s?new Date(s).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'—';
const P=id=>S.people.find(p=>p.id==id),C=id=>S.chats.find(c=>c.id==id);
const pchats=id=>S.chats.filter(c=>c.pid==id).sort((a,b)=>b.start.localeCompare(a.start));
const tl=s=>String(s||'').split(',').map(x=>x.trim()).filter(Boolean);
const ctags=c=>[...new Set(c.tags||[])];
function regTags(a){a.forEach(t=>{if(t&&!S.tags.includes(t))S.tags.push(t)})}
const txt=c=>{const p=P(c.pid)||{};return [c.notes,c.advice,c.follow,c.agenda,c.ai?.summary,(c.ai?.advice||[]).join(' '),(c.ai?.actions||[]).join(' '),ctags(c).join(' '),p.name,p.company,p.role,p.industry].join(' ').toLowerCase()};
const tagOpts=sel=>'<option value="">All topics</option>'+S.tags.slice().sort().map(t=>`<option ${t==sel?'selected':''}>${esc(t)}</option>`).join('');
function load(){try{const j=JSON.parse(localStorage.getItem(KEY)||'null');if(j)S=Object.assign(S,j)}catch(e){}if(!S.tagsInit){S.tags=[...new Set([...SUG,...(S.tags||[])])];S.tagsInit=1}view=S.settings.view||'month'}
let t;function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){toast('Could not save in this browser. Use Export JSON to keep a copy.')}clearTimeout(t);t=setTimeout(()=>{if(dbDoc)dbDoc.set({json:JSON.stringify(S)}).catch(()=>{})},600)}
function toast(m,undo){const e=$('#toast');e.innerHTML=esc(m)+(undo?' <u id="ud">Undo</u>':'');e.className='s';if(undo)$('#ud').onclick=()=>{S=JSON.parse(undoSnap);save();e.className='';render();closePanel();};clearTimeout(toast.t);toast.t=setTimeout(()=>e.className='',6000)}
function snap(){undoSnap=JSON.stringify(S)}
function nav(){$('#nav').innerHTML='<div class="logo"><i></i>Coffee Chats</div>'+PAGES.map(([k,l])=>`<a class="${page==k?'on':''}" data-go="${k}"><svg viewBox="0 0 24 24">${ICON[k]}</svg><span>${l}</span></a>`).join('')}
function render(){nav();({cal:rCal,ppl:rPpl,ai:rAi,set:rSet})[page]()}
/* CALENDAR */
function rCal(){
 const now=new Date(),y=cur.getFullYear(),m=cur.getMonth();let days=[],title;
 if(view=='month'){const f=new Date(y,m,1),s=new Date(f);s.setDate(1-((f.getDay()+6)%7));for(let i=0;i<42;i++){const d=new Date(s);d.setDate(s.getDate()+i);days.push(d)}title=cur.toLocaleDateString('en-GB',{month:'long',year:'numeric'})}
 else if(view=='week'){const s=new Date(cur);s.setDate(cur.getDate()-((cur.getDay()+6)%7));for(let i=0;i<7;i++){const d=new Date(s);d.setDate(s.getDate()+i);days.push(d)}title='Week of '+fd(days[0])}
 const evs=d=>S.chats.filter(c=>c.start.slice(0,10)==ld(d)).sort((a,b)=>a.start.localeCompare(b.start));
 const chip=c=>{const p=P(c.pid)||{};const past=new Date(c.start)<now;const ind=(c.notes||c.advice?'●':'')+(c.ai?'✦':'');return `<span class="ev ${past?'past':''} ${c.status=='cancelled'?'x':''}" data-chat="${c.id}">${c.start.slice(11,16)} ${esc(p.name)} ${ind}</span>`};
 let body;
 if(view=='agenda'){const all=[...S.chats].sort((a,b)=>a.start.localeCompare(b.start));const up=all.filter(c=>new Date(c.start)>=now),pa=all.filter(c=>new Date(c.start)<now).reverse();title='Agenda';
  const list=(a,h)=>`<h2>${h}</h2>`+(a.length?a.map(c=>{const p=P(c.pid)||{};return `<div class="card" style="margin-bottom:8px;cursor:pointer" data-chat="${c.id}"><b>${esc(p.name)}</b> <span class="mut">${esc([p.role,p.company].filter(Boolean).join(', '))}</span><div class="mut">${fmt(c.start)} · ${c.status}</div>${(c.ai?.tags||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div>`}).join(''):'<div class="mut">Nothing here.</div>');
  body=list(up,'Upcoming')+list(pa,'Previous')}
 else body='<div class="grid">'+['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(d=>`<div class="dh">${d}</div>`).join('')+days.map(d=>`<div class="day ${view=='month'&&d.getMonth()!=m?'o':''} ${ld(d)==ld(now)?'t':''}" data-newday="${ld(d)}"><b>${d.getDate()}</b>${evs(d).map(chip).join('')}</div>`).join('')+'</div>';
 $('#main').innerHTML=`<h1>Calendar</h1><div class="sub">● has notes · ✦ has AI summary</div><div class="bar">${view!='agenda'?'<button data-nav="-1">‹</button><button data-nav="0">Today</button><button data-nav="1">›</button><b>'+title+'</b>':''}<span class="sp"></span>${['month','week','agenda'].map(v=>`<button class="${view==v?'on':''}" data-view="${v}">${v[0].toUpperCase()+v.slice(1)}</button>`).join('')}<button class="p" data-newchat="">+ New chat</button></div>${S.chats.length||S.people.length?'':'<div class="card empty">No chats yet. Create your first chat, or load demo data in Settings.</div>'}${body}`}
/* PEOPLE */
function rPpl(){
 const inds=[...new Set(S.people.map(p=>p.industry).filter(Boolean))].sort();
 let L=S.people.filter(p=>(!pind||p.industry==pind)&&(!pco||p.company==pco)&&(!ptag||(p.tags||[]).includes(ptag)||pchats(p.id).some(c=>ctags(c).includes(ptag)))&&(!pfrom||pchats(p.id).some(c=>c.start.slice(0,10)>=pfrom))&&(!pq||[p.name,p.company,p.role,p.bg,(p.tags||[]).join(' '),pchats(p.id).map(txt).join(' ')].join(' ').toLowerCase().includes(pq.toLowerCase())));
 const last=p=>pchats(p.id).filter(c=>c.status=='completed')[0]?.start||'';
 L.sort((a,b)=>psort=='recent'?last(b).localeCompare(last(a)):String(a[psort]||'').localeCompare(String(b[psort]||'')));
 const tags=p=>(p.tags||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join('');
 const body=!L.length?`<div class="card empty">${S.people.length?'No one matches that search.':'Add the first person you want to keep in touch with.'}</div>`:pmode=='table'?`<div class="card" style="padding:0;overflow:auto"><table><tr><th data-sort="name">Name</th><th data-sort="role">Title</th><th data-sort="company">Company</th><th data-sort="industry">Industry</th><th data-sort="recent">Last chat</th><th>Chats</th></tr>${L.map(p=>`<tr class="r" data-person="${p.id}"><td><b>${esc(p.name)}</b>${p.demo?' <span class="demo">demo</span>':''}</td><td>${esc(p.role)}</td><td>${esc(p.company)}</td><td>${esc(p.industry)}</td><td>${fd(last(p))}</td><td>${pchats(p.id).length}</td></tr>`).join('')}</table></div>`:`<div class="cards">${L.map(p=>`<div class="card" data-person="${p.id}"><b>${esc(p.name)}</b>${p.demo?' <span class="demo">demo</span>':''}<div class="mut">${esc([p.role,p.company].filter(Boolean).join(', '))}</div><div style="margin:6px 0">${tags(p)}</div><div class="mut">${pchats(p.id).length} chats · last ${fd(last(p))}</div></div>`).join('')}</div>`;
 $('#main').innerHTML=`<h1>People</h1><div class="sub">Everyone you've networked with.</div><div class="bar"><input id="pq" style="max-width:260px" placeholder="Search name, company, title, keyword" value="${esc(pq)}"><select id="pind" style="max-width:170px"><option value="">All industries</option>${inds.map(i=>`<option ${i==pind?'selected':''}>${esc(i)}</option>`).join('')}</select><select id="ptag" style="max-width:150px">${tagOpts(ptag)}</select><select id="pco" style="max-width:150px"><option value="">All companies</option>${[...new Set(S.people.map(p=>p.company).filter(Boolean))].sort().map(c=>`<option ${c==pco?'selected':''}>${esc(c)}</option>`).join('')}</select><input type="date" id="pfrom" value="${pfrom}" title="Chats since" style="max-width:140px"><select id="psort" style="max-width:160px">${[['name','Name'],['company','Company'],['industry','Industry'],['recent','Most recent']].map(([k,l])=>`<option value="${k}" ${psort==k?'selected':''}>Sort: ${l}</option>`).join('')}</select><span class="sp"></span><button class="${pmode=='table'?'on':''}" data-pmode="table">Table</button><button class="${pmode=='cards'?'on':''}" data-pmode="cards">Cards</button><button class="p" data-newperson="">+ Add person</button></div>${body}`;
 const q=$('#pq');if(document.activeElement===document.body&&pq){q.focus();q.setSelectionRange(pq.length,pq.length)}}
function openPanel(h){$('#pn').innerHTML=h;$('#pn').className='s';$('#ov').className='s'}
function closePanel(){$('#pn').className='';$('#ov').className=''}
function personForm(id){const p=P(id)||{};openPanel(`<h1>${id?'Edit':'Add'} person</h1><label>Full name *</label><input id="f_name" value="${esc(p.name)}"><div class="row"><div><label>Job title</label><input id="f_role" value="${esc(p.role)}"></div><div><label>Company</label><input id="f_company" value="${esc(p.company)}"></div></div><div class="row"><div><label>Industry</label><input id="f_industry" value="${esc(p.industry)}"></div><div><label>Profile URL</label><input id="f_url" value="${esc(p.url)}" placeholder="https://linkedin.com/in/…"></div></div><label>Tags (comma separated)</label><input id="f_tags" value="${esc((p.tags||[]).join(', '))}"><label>Background (your own notes)</label><textarea id="f_bg">${esc(p.bg)}</textarea><div class="bar" style="margin-top:16px"><button class="p" data-saveperson="${id||''}">Save</button><button data-close>Cancel</button></div>`)}
function savePerson(id){const g=k=>$('#f_'+k).value.trim();if(!g('name'))return toast('Please enter a name.');const url=g('url');if(url&&!/^https?:\/\//.test(url))return toast('Profile URL should start with http(s)://');snap();const o={name:g('name'),role:g('role'),company:g('company'),industry:g('industry'),url,bg:g('bg'),tags:g('tags').split(',').map(s=>s.trim()).filter(Boolean)};let pid=id;if(id)Object.assign(P(id),o);else{pid=uid();S.people.push({id:pid,...o})}save();render();personView(pid);toast('Saved.')}
function personView(id){const p=P(id);if(!p)return;const cs=pchats(id);openPanel(`<div class="bar"><h1 style="margin:0">${esc(p.name)}</h1><span class="sp"></span><button data-close>✕</button></div><div class="mut">${esc([p.role,p.company,p.industry].filter(Boolean).join(' · '))}</div>${p.url?`<div><a class="link" href="${esc(p.url)}" target="_blank" rel="noopener">Profile link</a></div>`:''}<div style="margin-top:6px">${[...new Set([...(p.tags||[]),...cs.flatMap(ctags)])].map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div>${p.bg?`<h2>Background (your notes)</h2><div>${esc(p.bg)}</div>`:''}${p.research?`<h2>Research &amp; suggested questions</h2><div class="ai"><small>AI-generated · unverified</small><div style="white-space:pre-wrap">${esc(p.research)}</div></div>`:''}<div class="bar" style="margin-top:12px"><button data-newchat="${id}" class="p">Schedule chat</button><button data-research="${id}">${p.research?'Regenerate':'Prepare for chat'}</button><button data-editperson="${id}">Edit</button><button class="d" data-delperson="${id}">Delete</button></div><h2>Conversation history (${cs.length})</h2>${cs.length?cs.map(c=>`<div class="card" style="margin-bottom:8px;cursor:pointer" data-chat="${c.id}"><b>${fd(c.start)}</b> <span class="mut">${c.status}${c.loc?' · '+esc(c.loc):''}</span>${c.advice?`<div>${esc(c.advice.slice(0,140))}${c.advice.length>140?'…':''}</div>`:''}${c.ai?`<div class="ai"><small>AI summary</small><div>${esc(c.ai.summary)}</div></div>`:''}</div>`).join(''):'<div class="mut">No chats yet.</div>'}`)}
async function research(id){const p=P(id);if(!sample)return toast('AI is not available in this view.');const b=document.querySelector('[data-research]');b.disabled=true;b.textContent='Working…';try{const r=await sample(`Create coffee-chat preparation for a student/early-career person meeting this professional. You have NO web access, so use ONLY the details given; do not invent biography, employers, publications or achievements. Start with one line: "Based only on the details you entered." Then give 8 tailored questions (role, industry, career path, skills, follow-ups). Plain text, no markdown.\n\nName: ${p.name}\nTitle: ${p.role}\nCompany: ${p.company}\nIndustry: ${p.industry}\nProfile: ${p.url}\nUser's notes: ${p.bg}`,{cache:false});snap();p.research=r.text;save();personView(id)}catch(e){toast('Could not generate: '+(e.message||e.code||'error')+'. You can still add background manually.');b.disabled=false;b.textContent='Prepare for chat'}}
function delPerson(id){const n=pchats(id).length;openPanel(`<h1>Delete ${esc(P(id).name)}?</h1><p>${n?`They have ${n} recorded chat${n>1?'s':''}. Choose what happens to them:`:'This person has no chats.'}</p><div class="bar" style="flex-direction:column;align-items:stretch">${n?`<button class="d" data-doDelP="${id}|all">Delete person and their chats</button><button data-reassign="${id}">Keep chats — move to another person…</button>`:`<button class="d" data-doDelP="${id}|all">Delete person</button>`}<button data-close>Cancel</button></div>`)}
/* CHAT */
function chatForm(id,pid,day){const c=C(id)||{};const d=new Date();d.setMinutes(0,0,0);d.setHours(d.getHours()+1);const start=c.start||(day?day+'T10:00':lt(d));const sel=c.pid||pid||'';
