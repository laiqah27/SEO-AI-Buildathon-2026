const PROMPTS=["Compare the advice from software engineers and data scientists.","What questions can't my notes answer yet?","What is the most common career advice I've received?","What actionable steps have people recommended to me?","What have professionals said about getting internships?","Which people should I follow up with, and why?","What patterns or contradictions appear across my conversations?","What skills should I prioritise based on my conversations?"];
function rAi(){const U=a=>[...new Set(a.filter(Boolean))].sort(),o=(k,l,a)=>`<select data-af="${k}" style="max-width:150px"><option value="">${l}</option>${a.map(x=>`<option ${AF[k]==x?'selected':''}>${esc(x)}</option>`).join('')}</select>`;const AFH=`<div class="bar" style="gap:6px">${o('person','Person',U(S.people.map(p=>p.name)))}${o('industry','Industry',U(S.people.map(p=>p.industry)))}${o('company','Company',U(S.people.map(p=>p.company)))}${o('role','Job role',U(S.people.map(p=>p.role)))}${o('topic','Topic',S.tags.slice().sort())}<input type="date" data-af="from" value="${AF.from||''}" title="From" style="max-width:140px"><input type="date" data-af="to" value="${AF.to||''}" title="To" style="max-width:140px"><button data-clearaf="1">Clear</button></div>`;$('#main').innerHTML=`<h1>Your networking knowledge, in one place.</h1><div class="sub">Answers use only what you've recorded. Filters narrow which chats are used.</div>${AFH}${chatLog.length?'':`<div class="prompts">${PROMPTS.map(q=>`<div data-ask="${esc(q)}">${esc(q)}</div>`).join('')}</div>`}<div id="log">${chatLog.map(m=>`<div class="msg ${m.r}">${m.r=='a'?m.h:esc(m.t)}</div>`).join('')}</div><div class="bar" style="position:sticky;bottom:12px;background:var(--bg);padding:8px 0"><input id="q" placeholder="Ask about your conversations…"><button class="p" id="send" style="flex:none">Send</button></div>`;$('#q').onkeydown=e=>{if(e.key=='Enter')ask($('#q').value)};$('#send').onclick=()=>ask($('#q').value)}
function passAF(c){const p=P(c.pid)||{},f=AF,d=c.start.slice(0,10);return(!f.person||p.name==f.person)&&(!f.industry||p.industry==f.industry)&&(!f.company||p.company==f.company)&&(!f.role||p.role==f.role)&&(!f.topic||ctags(c).includes(f.topic)||(c.ai?.tags||[]).includes(f.topic))&&(!f.from||d>=f.from)&&(!f.to||d<=f.to)}
function retrieve(q){const w=q.toLowerCase().split(/\W+/).filter(x=>x.length>3);const rec=S.chats.filter(c=>(c.notes||c.advice||c.ai)&&passAF(c)).map(c=>{const p=P(c.pid)||{};const txt=[c.notes,c.advice,c.follow,p.name,p.role,p.company,p.industry,(c.ai?.tags||[]).join(' ')].join(' ').toLowerCase();return{c,p,s:w.reduce((a,x)=>a+(txt.includes(x)?1:0),0)}});return rec.sort((a,b)=>b.s-a.s||b.c.start.localeCompare(a.c.start)).slice(0,12)}
async function ask(q){q=q.trim();if(!q)return;chatLog.push({r:'u',t:q});if(!sample){chatLog.push({r:'a',h:'AI is not available in this view.'});return rAi()}
 const R=retrieve(q);chatLog.push({r:'a',h:'Thinking…'});rAi();const idx=chatLog.length-1;
 if(!R.length){chatLog[idx].h='No recorded notes or advice match these filters, so I have nothing to answer from. Clear a filter or record more notes, then ask again.';return rAi()}
 const ctx=R.map(({c,p},i)=>`[${i+1}] ${p.name} (${p.role||''}, ${p.company||''}, ${p.industry||''}) on ${c.start.slice(0,10)}\nNotes: ${c.notes}\nAdvice: ${c.advice}\nFollow-up: ${c.follow}`).join('\n\n');
 const hist=chatLog.slice(0,-2).slice(-6).map(m=>({role:m.r=='u'?'user':'assistant',content:m.t||m.h.replace(/<[^>]+>/g,'')}));
 try{const r=await sample([...hist,{role:'user',content:`Answer the question using ONLY these records of the user's coffee chats. Cite sources as [n]. Never invent advice or attribute things people did not say. Separate what people said from your own suggestions. If records are insufficient, say so. Where relevant use these headings: "Recorded advice" (what professionals explicitly said, cited), "Patterns I inferred" (themes or conflicts across people, labelled as inference), "New suggestions from AI" (your own ideas, clearly not from any professional), "Gaps" (what the records cannot answer). Compare people, flag conflicts, list concrete action items. No invented quotes or statistics. Plain text, concise.\n\nRECORDS:\n${ctx}\n\nQUESTION: ${q}`}],{cache:false,onText:({text})=>{chatLog[idx].h=fmtAns(text,R);rAi()}});chatLog[idx].h=fmtAns(r.text,R)}catch(e){chatLog[idx].h='Sorry, that failed ('+esc(e.message||e.code||'error')+'). Please try again.'}rAi()}
function fmtAns(t,R){return esc(t).replace(/\[(\d+)\]/g,(m,n)=>{const x=R[n-1];return x?`<span class="link" data-chat="${x.c.id}" title="${esc(x.p.name)}">[${esc(x.p.name)}, ${x.c.start.slice(0,10)}]</span>`:m})}
